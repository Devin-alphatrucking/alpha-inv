# --- Database (local Docker Postgres, see docker-compose.yml) ---
DATABASE_URL="postgresql://invoice_crm:invoice_crm_dev_password@localhost:5433/invoice_crm?schema=public"
# Production: DATABASE_URL = the ordinary `app_runtime` role (see packages/db/prisma/rls-setup/app-role.sql),
# so Row-Level Security applies. MIGRATE_DATABASE_URL = the OWNER role, used only by migrations and seeding.
# Leave MIGRATE_DATABASE_URL empty on a local database that has no separate app role.
MIGRATE_DATABASE_URL=""

# --- NextAuth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-32-byte-secret"
AUTH_TRUST_HOST="true"
# Local default. For Cloudflare Tunnel, set to your current https://….trycloudflare.com URL
# and restart npm run dev.
AUTH_URL="http://localhost:3000"

# --- Secret encryption (per-project Azure keys saved from the admin UI) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this value safe and backed up: if it is lost, saved project keys must be re-entered.
APP_ENCRYPTION_KEY="replace-with-a-random-32-byte-base64-secret"

# --- Azure Document Intelligence (Form Recognizer) ---
# Server-wide fallback. Each project can store its own endpoint/key in Projects > Edit.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT="https://<your-resource-name>.cognitiveservices.azure.com/"
AZURE_DOCUMENT_INTELLIGENCE_KEY="<key-from-azure-portal>"

# --- Azure Blob Storage (optional) ---
# Leave empty to store uploads under .data/uploads for local/dev.
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER_NAME="invoices"

# --- Seed script ---
# First company created by `npm run db:seed` on a fresh database (an existing company is never renamed).
SEED_COMPANY_NAME="My Company"
SEED_COMPANY_SLUG="my-company"
SEED_ADMIN_EMAIL="admin@example.com"
# Leave passwords empty to get a random one printed once by `npm run db:seed`.
SEED_ADMIN_PASSWORD=""
SEED_STAFF_EMAIL="staff@example.com"
SEED_STAFF_PASSWORD=""

# --- Product name shown when no company branding applies (sign-in page without a company code, PWA name) ---
PRODUCT_NAME="Invoice & Billing"

# --- Email (needed for sign-up confirmation, password reset and invitations) ---
# smtp = real delivery; file = development only (writes to .data/outbox.jsonl); leave unset to auto-pick.
EMAIL_TRANSPORT=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Invoice & Billing <no-reply@yourdomain.com>"
# Public address of this app. Links in emails are built from it. REQUIRED in production.
APP_URL="http://localhost:3000"
# Optional: links shown next to "I agree to the terms" on sign-up (https only).
TERMS_URL=""
PRIVACY_URL=""
# Set to "false" to turn off self-service company sign-up.
SIGNUP_ENABLED="true"
# The public landing and pricing pages at "/" and "/pricing". Set to "off" on a deployment that is only one company's own app: "/" then goes to the sign-in page.
LANDING_PAGE="on"
# Where customers send support requests (planned: shown on the Help page).
SUPPORT_EMAIL=""

# --- Plans (Phase 4) ---
# Length of the free trial for companies that sign up themselves (days).
TRIAL_DAYS="14"

# --- Payments: Razorpay (Phase 5) ---
# Leave the key empty to keep payments off (customers are then asked to contact support to add a project plan).
# Use TEST keys (rzp_test_...) until you go live. Key secret and webhook secret stay on the server only.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Set the same value in Razorpay Dashboard > Webhooks (URL: <APP_URL>/api/billing/razorpay/webhook).
# Events to tick: all "subscription.*" events (authenticated, activated, charged, pending, halted, cancelled, completed, paused, resumed, updated).
RAZORPAY_WEBHOOK_SECRET=""
# Days after the first failed charge before adding projects, people and invoices is paused (default 7).
BILLING_GRACE_DAYS="7"
# Optional: lets a scheduler call POST <APP_URL>/api/billing/reconcile (header "Authorization: Bearer <secret>", 16+ characters)
# to re-read unfinished purchases from Razorpay once a day, as a safety net for a missed webhook.
BILLING_CRON_SECRET=""

# --- Daily email digest ---
# A scheduler calls POST <APP_URL>/api/jobs/digest with "Authorization: Bearer <JOBS_SECRET>" once an hour (16+ characters; empty switches it off).
# Each company gets ONE email a day to its administrators, from DIGEST_HOUR (0-23, default 8) in the company's own time zone,
# only when something is overdue, due in the next 7 days, or waiting for review. People can turn it off on their Account page.
JOBS_SECRET=""
DIGEST_HOUR="8"
